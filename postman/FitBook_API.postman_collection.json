    {
      "name": "04 - Création d'un coach (sauvegarde coachId et coachEmail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const donnees = pm.response.json();",
              "pm.environment.set(\"coachId\", donnees.id);",
              "pm.environment.set(\"coachEmail\", donnees.email);",
              "",
              "pm.test(\"Status 201 Created\", function () {",
