        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Test\",\n  \"prenom\": \"Coach\",\n  \"email\": \"coach{{$timestamp}}@test.be\",\n  \"motDePasse\": \"Test_1234\",\n  \"role\": \"ROLE_COACH\"\n}",
          "options": {
