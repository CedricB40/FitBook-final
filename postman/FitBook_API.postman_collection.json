    {
      "name": "08 - Modification de la séance (avec seanceId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"La séance a bien été modifiée\", function () {",
              "    const donnees = pm.response.json();",
              "    pm.expect(donnees.dateHeureDebut).to.eql(\"2026-12-15 14:00:00\");",
              "});"
            ]
          }
        }
      ],
